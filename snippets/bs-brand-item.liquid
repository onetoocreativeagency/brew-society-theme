{% comment %}
  Renders one piece of output for one collection; nothing for collections that
  are not brands. Called by snippets/bs-brand-each.liquid.

  Accepts:
  - brand: {Object} a collection
  - item: {String} 'tally' (an x, for counting), 'category' (the category value between [[ and ]]),
    'card' (a grid card) or 'row' (a list view row)
  - config: {Object} the section's settings (metafield namespace and keys, card options)
  - index: {Number} position in the loop, used to lazy-load later card images

  Usage:
  {% render 'bs-brand-item', brand: collection, item: 'row', config: section.settings, index: 1 %}
{% endcomment %}
{%- liquid
  if brand.template_suffix != 'brand'
    assign item = ''
  endif
  assign bs_meta = brand.metafields[config.namespace]
  assign bs_category = bs_meta[config.category_key].value
-%}
{%- case item -%}
  {%- when 'tally' -%}
    x
  {%- when 'category' -%}
    {%- if bs_category != blank -%}
      {{- bs_category | prepend: '[[' | append: ']]' -}}
    {%- endif -%}
  {%- when 'card' -%}
    {%- liquid
      assign bs_lazy = false
      if index > 8
        assign bs_lazy = true
      endif
    -%}
    <li data-brand data-category="{{ bs_category | handleize }}">
      {%- render 'bs-brand-card',
        brand: brand,
        image_source: config.card_image,
        panel_scheme: config.card_color_scheme,
        lazy_load: bs_lazy,
        namespace: config.namespace,
        category_key: config.category_key,
        origin_key: config.origin_key,
        exclusive_key: config.exclusive_key,
        new_key: config.new_key,
        logo_key: config.logo_key,
        range_size_key: config.range_size_key
      -%}
    </li>
  {%- when 'row' -%}
    {%- liquid
      assign bs_range = bs_meta[config.range_size_key].value | default: brand.all_products_count
      assign bs_image = brand.image | default: bs_meta[config.logo_key].value
    -%}
    <tr class="bs-brand-list__row" role="row" data-brand data-category="{{ bs_category | handleize }}">
      <td class="bs-brand-list__name" role="cell">
        <a href="{{ brand.url }}" class="bs-brand-list__link">{{ brand.title | escape }}</a>
        {%- if bs_image != blank -%}
          {{-
            bs_image
            | image_url: width: 600
            | image_tag: loading: 'lazy', widths: '300, 600', sizes: '233px', alt: '', class: 'bs-brand-list__image'
          -}}
        {%- endif -%}
      </td>
      <td class="bs-brand-list__category" role="cell">{{ bs_category | escape }}</td>
      <td class="bs-brand-list__products" role="cell">
        {%- if bs_range > 0 -%}
          {{ bs_range }}
        {%- endif -%}
      </td>
      <td class="bs-brand-list__origin" role="cell">{{ bs_meta[config.origin_key].value | escape }}</td>
      <td class="bs-brand-list__type" role="cell">
        {%- for bs_relationship in bs_meta[config.relationship_key].value -%}
          {{- bs_relationship | escape -}}
          {%- unless forloop.last %}, {% endunless -%}
        {%- endfor -%}
      </td>
    </tr>
{%- endcase -%}
