      "settings": {
        "label": "About",
        "text": "<p>We started as a cafe supplier. Today most of what we do is bring brands into Australia that nobody else has, and get them onto the shelves of the grocers, pantries and delis that care about what they stock.</p><p>We still supply cafes and restaurants every week, and we still carry the staples that keep a cafe running. The difference now is the range around them.</p>",
        "position": "right",
        "color_scheme": "scheme-2",
        "padding_top": 16,
        "padding_bottom": 32
      }
    },
    "closing": {
      "type": "bs-statement",
      "settings": {
        "text": "Finding, developing and distributing <strong>brands the world wants</strong>",
