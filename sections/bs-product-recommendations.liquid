{%- comment -%}
  "You might also like" on product pages: Shopify's product recommendations (related products,
  which are the ones picked per product in the Search & Discovery app, then Shopify's automatic
  ones), always filled to the set number of products.

  The page renders that many products from the fallback collection straight away (never the
  product itself). assets/bs-product-recommendations.js then fetches the recommendations and puts
  them first, topping up with the fallback products, without repeats. Without JS, or if the
  fetch fails, the fallback products stay. The fetched copy of this section (the
  recommendations endpoint) renders the recommended products only.
{%- endcomment -%}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'section-related-products.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.8 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign bs_limit = section.settings.products_to_show
  assign bs_fallback = section.settings.fallback_collection | default: collections.all
  assign bs_shown = 0
-%}
{%- capture bs_items -%}
  {%- if recommendations.performed? -%}
    {%- for bs_product in recommendations.products -%}
      <li class="grid__item" data-product-id="{{ bs_product.id }}">
        {%- render 'card-product',
          card_product: bs_product,
          section_id: section.id,
          product_view_context: 'recommendation'
        -%}
      </li>
    {%- endfor -%}
  {%- else -%}
    {%- for bs_product in bs_fallback.products limit: 50 -%}
      {%- if bs_product.id == product.id or bs_product.available == false -%}
        {%- continue -%}
      {%- endif -%}
      {%- if bs_shown >= bs_limit -%}
        {%- break -%}
      {%- endif -%}
      {%- assign bs_shown = bs_shown | plus: 1 -%}
      <li class="grid__item" data-product-id="{{ bs_product.id }}">
        {%- render 'card-product',
          card_product: bs_product,
          section_id: section.id,
          product_view_context: 'recommendation'
        -%}
      </li>
    {%- endfor -%}
  {%- endif -%}
{%- endcapture -%}

{%- if bs_items != blank -%}
  <script src="{{ 'bs-product-recommendations.js' | asset_url }}" defer="defer"></script>
  <div class="color-{{ section.settings.color_scheme }} gradient">
    <bs-product-recommendations
      class="related-products page-width section-{{ section.id }}-padding isolate"
      data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ bs_limit }}&intent=related"
      data-limit="{{ bs_limit }}"
      data-product-id="{{ product.id }}"
    >
      {%- if section.settings.heading != blank -%}
        <h2 class="related-products__heading {{ section.settings.heading_size }}">
          {{- section.settings.heading | escape -}}
        </h2>
      {%- endif -%}
      <ul class="grid product-grid grid--4-col-desktop grid--2-col-tablet-down" role="list" data-list>
        {{- bs_items -}}
      </ul>
    </bs-product-recommendations>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "You might also like",
  "tag": "section",
  "class": "section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Shopify's recommendations for the product. Pick them per product in the Search & Discovery app (Related products); Shopify adds its own after those. The row is always filled from the collection below, so it never shows fewer products than set."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You might also like"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" },
        { "value": "hxxl", "label": "Extra large" }
      ],
      "default": "hxxl"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "collection",
      "id": "fallback_collection",
      "label": "Fill with products from",
      "info": "Used when there are fewer recommendations than products to show, in the collection's order. Leave empty for all products."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "You might also like"
    }
  ]
}
{% endschema %}
