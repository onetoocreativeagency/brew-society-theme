{{ 'bs-choice.css' | asset_url | stylesheet_tag }}
{{ 'bs-pill-xl.css' | asset_url | stylesheet_tag }}
{{ 'section-contact-form.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign contact_phone_href = section.settings.phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-'
  assign type_options = section.settings.type_options | newline_to_br | strip_newlines | split: '<br />'
  assign contact_form_class = 'contact__form isolate'
  if settings.animations_reveal_on_scroll
    assign contact_form_class = 'contact__form isolate scroll-trigger animate--slide-in'
  endif
-%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="contact page-width section-{{ section.id }}-padding">
    {%- if section.settings.email != blank or section.settings.phone != blank -%}
      <div class="contact__direct">
        {%- if section.settings.email != blank and section.settings.email_label != blank -%}
          <a class="button bs-pill-xl" href="mailto:{{ section.settings.email | strip | escape }}">
            {{- section.settings.email_label | escape -}}
          </a>
        {%- endif -%}
        {%- if section.settings.phone != blank and section.settings.phone_label != blank -%}
          <a class="button bs-pill-xl bs-pill-xl--tint" href="tel:{{ contact_phone_href | escape }}">
            {{- section.settings.phone_label | escape -}}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="contact__heading inline-richtext {{ section.settings.heading_size }}">
        {{ section.settings.heading }}
      </h2>
    {%- else -%}
      <h2 class="visually-hidden">{{ 'templates.contact.form.title' | t }}</h2>
    {%- endif -%}

    {%- form 'contact', id: 'ContactForm', class: contact_form_class -%}
      {%- if form.posted_successfully? -%}
        <p class="contact__status contact__status--success form-status" role="status" tabindex="-1" autofocus>
          {{- 'icon-success.svg' | inline_asset_content -}}
          <span>{{ 'templates.contact.form.post_success' | t }}</span>
        </p>
      {%- elsif form.errors -%}
        <div class="contact__status contact__status--error" role="alert" tabindex="-1" autofocus>
          {{- 'icon-error.svg' | inline_asset_content -}}
          <div>
            <p class="form-status">{{ 'templates.contact.form.error_heading' | t }}</p>
            <ul class="contact__status-list" role="list">
              {%- for field in form.errors -%}
                <li>
                  {%- if field == 'form' -%}
                    {{ form.errors.messages[field] }}
                  {%- else -%}
                    <a href="#ContactForm-{{ field }}" class="link">
                      {{- form.errors.translated_fields[field] | capitalize }}
                      {{ form.errors.messages[field] -}}
                    </a>
                  {%- endif -%}
                </li>
              {%- endfor -%}
            </ul>
          </div>
        </div>
      {%- endif -%}

      <div class="contact__fields">
        <div class="field">
          <input
            class="field__input"
            autocomplete="name"
            type="text"
            id="ContactForm-name"
            name="contact[{{ 'templates.contact.form.name' | t }}]"
            value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
            placeholder="{{ 'templates.contact.form.name' | t }}"
          >
          <label class="field__label" for="ContactForm-name">{{ 'templates.contact.form.name' | t }}</label>
        </div>
        <div class="field">
          <input
            class="field__input"
            autocomplete="organization"
            type="text"
            id="ContactForm-business"
            name="contact[{{ 'templates.contact.form.business' | t }}]"
            placeholder="{{ 'templates.contact.form.business' | t }}"
          >
          <label class="field__label" for="ContactForm-business">
            {{- 'templates.contact.form.business' | t -}}
          </label>
        </div>
        <div class="field">
          <input
            type="tel"
            id="ContactForm-phone"
            class="field__input"
            autocomplete="tel"
            name="contact[{{ 'templates.contact.form.phone' | t }}]"
            pattern="[0-9+() \-]*"
            value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
            placeholder="{{ 'templates.contact.form.phone' | t }}"
          >
          <label class="field__label" for="ContactForm-phone">{{ 'templates.contact.form.phone' | t }}</label>
        </div>
        <div class="field field--with-error">
          <input
            autocomplete="email"
            type="email"
            id="ContactForm-email"
            class="field__input"
            name="contact[email]"
            spellcheck="false"
            autocapitalize="off"
            value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
            required
            aria-required="true"
            {% if form.errors contains 'email' %}
              aria-invalid="true"
              aria-describedby="ContactForm-email-error"
            {% endif %}
            placeholder="{{ 'templates.contact.form.email' | t }}"
          >
          <label class="field__label" for="ContactForm-email">
            {{- 'templates.contact.form.email' | t }}
            <span aria-hidden="true">*</span></label
          >
          {%- if form.errors contains 'email' -%}
            <small class="contact__field-error" id="ContactForm-email-error">
              <span class="visually-hidden">{{ 'accessibility.error' | t }}</span>
              {{ form.errors.translated_fields.email | capitalize }}
              {{ form.errors.messages.email }}
            </small>
          {%- endif -%}
        </div>
      </div>

      {%- if type_options.size > 0 and section.settings.type_options != blank -%}
        <div class="contact__type" role="radiogroup" aria-labelledby="ContactForm-type-label">
          <span class="contact__type-label" id="ContactForm-type-label">
            {{- 'templates.contact.form.type' | t -}}
          </span>
          <div class="bs-choice">
            {%- assign first_option = true -%}
            {%- for option in type_options -%}
              {%- assign option_label = option | strip -%}
              {%- if option_label == blank -%}
                {%- continue -%}
              {%- endif -%}
              <span class="bs-choice__option">
                <input
                  class="bs-choice__input"
                  type="radio"
                  name="contact[{{ 'templates.contact.form.type' | t }}]"
                  id="ContactForm-type-{{ forloop.index }}"
                  value="{{ option_label | escape }}"
                  {% if first_option %}
                    checked
                  {% endif %}
                >
                <label class="bs-choice__label" for="ContactForm-type-{{ forloop.index }}">
                  {{- option_label | escape -}}
                </label>
              </span>
              {%- assign first_option = false -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}

      <div class="field">
        <textarea
          rows="5"
          id="ContactForm-body"
          class="text-area field__input"
          name="contact[{{ 'templates.contact.form.comment' | t }}]"
          placeholder="{{ 'templates.contact.form.comment' | t }}"
        >
          {{- form.body -}}
        </textarea>
        <label class="form__label field__label" for="ContactForm-body">
          {{- 'templates.contact.form.comment' | t -}}
        </label>
      </div>

      <button type="submit" class="contact__submit button bs-pill-xl">
        {{ 'templates.contact.form.send' | t }}
      </button>
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.contact-form.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "t:sections.contact-form.settings.title.default",
      "label": "t:sections.contact-form.settings.title.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        },
        {
          "value": "hxl",
          "label": "t:sections.all.heading_size.options__4.label"
        },
        {
          "value": "hxxl",
          "label": "t:sections.all.heading_size.options__5.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "header",
      "content": "Email and phone buttons"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email address",
      "info": "The Email button opens a new email to this address. Leave empty to hide the button."
    },
    {
      "type": "text",
      "id": "email_label",
      "label": "Email button label",
      "default": "Email Us"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone number",
      "info": "The Call button dials this number. Leave empty to hide the button."
    },
    {
      "type": "text",
      "id": "phone_label",
      "label": "Call button label",
      "default": "Call Us"
    },
    {
      "type": "header",
      "content": "Form"
    },
    {
      "type": "textarea",
      "id": "type_options",
      "label": "Enquiry types",
      "info": "One per line. The first is selected to start with. Remove a line to remove that choice, or leave empty to hide the Type row.",
      "default": "General\nVendor\nWholesale"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-6"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 256,
      "step": 8,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 256,
      "step": 8,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 128
    }
  ],
  "presets": [
    {
      "name": "t:sections.contact-form.presets.name"
    }
  ]
}
{% endschema %}
