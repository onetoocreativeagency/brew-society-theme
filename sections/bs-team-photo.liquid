{{ 'bs-team-photo.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- if section.settings.image != blank or request.design_mode -%}
  <div class="color-{{ section.settings.color_scheme }} gradient">
    <div class="bs-team-photo page-width section-{{ section.id }}-padding">
      <div class="bs-team-photo__frame">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 3360
            | image_tag:
              widths: '375, 750, 1100, 1500, 1780, 2400, 3360',
              sizes: '100vw',
              class: 'bs-team-photo__image'
          }}
        {%- else -%}
          {{ 'hero-apparel-1' | placeholder_svg_tag: 'bs-team-photo__image placeholder-svg' }}
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <ul class="bs-team-photo__people" role="list">
            {%- for block in section.blocks -%}
              {%- if block.settings.name == blank -%}
                {%- continue -%}
              {%- endif -%}
              <li
                class="bs-team-photo__person{% if block.settings.show_by_default %} bs-team-photo__person--default{% endif %}"
                {{ block.shopify_attributes }}
              >
                <button class="bs-team-photo__button" type="button">
                  <span class="bs-team-photo__dot"></span>
                  <span class="bs-team-photo__name">{{ block.settings.name | escape }}</span>
                </button>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Team photo",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 16,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Photo",
      "info": "Wide photo, about 3:2. Add a Person for each face, in order from left to right: each gets a dot along the bottom that shows their name."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-2"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 256,
      "step": 8,
      "unit": "px",
      "label": "Top padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 256,
      "step": 8,
      "unit": "px",
      "label": "Bottom padding",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "person",
      "name": "Person",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Name and role",
          "info": "For example: Harry, Director. The dot stays hidden until this is filled in."
        },
        {
          "type": "checkbox",
          "id": "show_by_default",
          "label": "Show this name before anyone hovers",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Team photo",
      "blocks": [
        {
          "type": "person"
        }
      ]
    }
  ]
}
{% endschema %}
