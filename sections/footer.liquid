{{ 'section-footer.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .footer {
    margin-top: {{ section.settings.margin_top | times: 0.75 | round: 0 }}px;
  }

  {%- comment -%} Figma: 192px top on desktop is 128px on mobile (two thirds); the bottom padding does not scale. {%- endcomment -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.667 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  @media screen and (min-width: 750px) {
    .footer {
      margin-top: {{ section.settings.margin_top }}px;
    }

    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
    }
  }
{%- endstyle -%}

{%- comment -%} The footer takes the page background, as the header does (snippets/bs-page-scheme.liquid). {%- endcomment -%}
{%- capture bs_page_scheme -%}{%- render 'bs-page-scheme' -%}{%- endcapture -%}
{%- assign bs_page_scheme = bs_page_scheme | strip -%}
<footer class="footer color-{{ bs_page_scheme | default: section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="footer__inner page-width">
    {%- assign cta_block = section.blocks | where: 'type', 'call_to_action' | first -%}
    {%- if cta_block -%}
      <div class="footer__cta" {{ cta_block.shopify_attributes }}>
        {%- if cta_block.settings.eyebrow != blank -%}
          <p class="footer__cta-eyebrow">{{ cta_block.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if cta_block.settings.heading != blank -%}
          <h2 class="footer__cta-heading hxxl">{{ cta_block.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if cta_block.settings.button_label_1 != blank or cta_block.settings.button_label_2 != blank -%}
          <div class="footer__cta-buttons">
            {%- if cta_block.settings.button_label_1 != blank -%}
              <a
                {% if cta_block.settings.button_link_1 != blank %}
                  href="{{ cta_block.settings.button_link_1 }}"
                {% else %}
                  role="link" aria-disabled="true"
                {% endif %}
                class="footer__pill button"
              >
                {{- cta_block.settings.button_label_1 | escape -}}
              </a>
            {%- endif -%}
            {%- if cta_block.settings.button_label_2 != blank -%}
              <a
                {% if cta_block.settings.button_link_2 != blank %}
                  href="{{ cta_block.settings.button_link_2 }}"
                {% else %}
                  role="link" aria-disabled="true"
                {% endif %}
                class="footer__pill footer__pill--tint button"
              >
                {{- cta_block.settings.button_label_2 | escape -}}
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="footer__main">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when '@app' -%}
              <div class="footer__block" {{ block.shopify_attributes }}>
                {% render block %}
              </div>
            {%- when 'pricing_signup' -%}
              <div class="footer__block footer__signup" {{ block.shopify_attributes }}>
                {%- if block.settings.heading != blank -%}
                  <h2 class="footer__signup-heading">{{ block.settings.heading | escape }}</h2>
                {%- endif -%}
                {%- form 'customer', id: 'FooterPricingForm', class: 'footer__signup-form' -%}
                  <input type="hidden" name="contact[tags]" value="{{ block.settings.customer_tag | escape }}">
                  <div class="footer__signup-field">
                    <label class="visually-hidden" for="FooterPricingEmail">{{ 'newsletter.label' | t }}</label>
                    <input
                      id="FooterPricingEmail"
                      type="email"
                      name="contact[email]"
                      value="{{ form.email }}"
                      placeholder="{{ block.settings.placeholder | escape }}"
                      autocorrect="off"
                      autocapitalize="off"
                      autocomplete="email"
                      {% if form.errors %}
                        autofocus
                        aria-invalid="true"
                        aria-describedby="FooterPricingMessage"
                      {% elsif form.posted_successfully? %}
                        aria-describedby="FooterPricingMessage"
                      {% endif %}
                      required
                    >
                    <button type="submit" name="commit">{{ block.settings.button_label | escape }}</button>
                  </div>
                  {%- if form.errors -%}
                    <p class="footer__signup-note" id="FooterPricingMessage" role="alert">
                      {{- form.errors.translated_fields.email | capitalize }}
                      {{ form.errors.messages.email -}}
                    </p>
                  {%- elsif form.posted_successfully? -%}
                    <p class="footer__signup-note" id="FooterPricingMessage" tabindex="-1" autofocus>
                      {{- block.settings.success_message | escape -}}
                    </p>
                  {%- elsif block.settings.small_print != blank -%}
                    <p class="footer__signup-note">{{ block.settings.small_print | escape }}</p>
                  {%- endif -%}
                {%- endform -%}
              </div>
            {%- when 'menu' -%}
              {%- if block.settings.menu.links.size > 0 -%}
                <ul class="footer__block footer__menu list-unstyled" role="list" {{ block.shopify_attributes }}>
                  {%- for link in block.settings.menu.links -%}
                    <li>
                      <a
                        href="{{ link.url }}"
                        class="footer__menu-link"
                        {% if link.current %}
                          aria-current="page"
                        {% endif %}
                      >
                        <span>{{ link.title | escape }}</span>
                        {%- render 'bs-menu-count', link: link -%}
                      </a>
                    </li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            {%- when 'wholesale_button' -%}
              {%- if settings.wholesale_portal_url != blank and block.settings.label != blank -%}
                <a
                  href="{{ settings.wholesale_portal_url }}"
                  class="footer__block footer__wholesale button"
                  target="_blank"
                  rel="noopener"
                  {{ block.shopify_attributes }}
                >
                  {{ block.settings.label | escape }}
                  <span class="visually-hidden">{{ 'accessibility.link_messages.new_window' | t }}</span>
                </a>
              {%- endif -%}
            {%- when 'social_links' -%}
              {%- liquid
                assign social_networks = 'instagram,linkedin,facebook,youtube,tiktok,twitter,pinterest,snapchat,tumblr,vimeo' | split: ','
              -%}
              {%- capture social_items -%}
                {%- for network in social_networks -%}
                  {%- liquid
                    if network == 'linkedin'
                      assign social_url = block.settings.linkedin_url
                    else
                      assign social_setting = 'social_' | append: network | append: '_link'
                      assign social_url = settings[social_setting]
                    endif
                    assign social_label = 'general.social.links.' | append: network
                  -%}
                  {%- if social_url != blank -%}
                    <li>
                      <a href="{{ social_url }}" target="_blank" rel="noopener">
                        {{- social_label | t -}}
                        <span class="visually-hidden">{{ 'accessibility.link_messages.new_window' | t }}</span>
                      </a>
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              {%- endcapture -%}
              {%- if social_items != blank -%}
                <ul class="footer__details list-unstyled" role="list" {{ block.shopify_attributes }}>
                  {{ social_items }}
                </ul>
              {%- endif -%}
            {%- when 'contact' -%}
              {%- if block.settings.address != blank or block.settings.email != blank or block.settings.phone != blank -%}
                <ul class="footer__details list-unstyled" role="list" {{ block.shopify_attributes }}>
                  {%- if block.settings.address != blank -%}
                    <li>{{ block.settings.address | escape }}</li>
                  {%- endif -%}
                  {%- if block.settings.email != blank -%}
                    <li>
                      <a href="mailto:{{ block.settings.email | escape }}">{{ block.settings.email | escape }}</a>
                    </li>
                  {%- endif -%}
                  {%- if block.settings.phone != blank -%}
                    <li>
                      <a href="tel:{{ block.settings.phone | remove: ' ' | escape }}">
                        {{- block.settings.phone | escape -}}
                      </a>
                    </li>
                  {%- endif -%}
                </ul>
              {%- endif -%}
          {%- endcase -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="footer__bottom">
      {%- if section.settings.image != blank -%}
        <div class="footer__image">
          {{
            section.settings.image
            | image_url: width: 2008
            | image_tag:
              loading: 'lazy',
              widths: '375, 750, 1004, 1500, 2008',
              sizes: '(min-width: 750px) 1004px, 100vw'
          }}
        </div>
      {%- endif -%}
      <div class="footer__legal">
        {%- if section.settings.policy_menu.links.size > 0 -%}
          <ul class="footer__policies list-unstyled" role="list">
            {%- for link in section.settings.policy_menu.links -%}
              <li>
                <a href="{{ link.url }}">{{ link.title | escape }}</a>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
        <span class="footer__copyright">{{ shop.name | escape }} {{ 'now' | date: '%Y' }}</span>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "t:sections.footer.name",
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "call_to_action",
      "name": "t:sections.footer.blocks.call_to_action.name",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "t:sections.footer.blocks.call_to_action.settings.paragraph.content"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "default": "t:sections.footer.blocks.call_to_action.settings.eyebrow.default",
