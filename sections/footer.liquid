{{ 'section-footer.css' | asset_url | stylesheet_tag }}
{{ 'bs-pill-xl.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .footer-parallax {
    margin-top: {{ section.settings.margin_top | times: 0.75 | round: 0 }}px;
  }

  {%- comment -%} Figma Footer V2: 24px bottom on desktop is 16px on mobile (two thirds); the top does not scale. {%- endcomment -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.667 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .footer-parallax {
      margin-top: {{ section.settings.margin_top }}px;
    }

    .section-{{ section.id }}-padding {
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  comment
    Social links: every account in Theme settings > Social media, with LinkedIn (not a Dawn
    social setting) from this section. Instagram and LinkedIn first, as in Figma.
  endcomment
  assign bs_networks = 'instagram,linkedin,facebook,youtube,tiktok,twitter,pinterest,snapchat,tumblr,vimeo' | split: ','
  assign bs_year = 'now' | date: '%Y'
-%}

{%- comment -%} The footer takes the page background, as the header does (snippets/bs-page-scheme.liquid). {%- endcomment -%}
{%- capture bs_page_scheme -%}{%- render 'bs-page-scheme' -%}{%- endcapture -%}
{%- assign bs_page_scheme = bs_page_scheme | strip -%}
{%- comment -%}
  The footer parallax (Osmo, assets/bs-footer-parallax.js: the footer rose out from under the page
  under a fading dark veil) is off at Marcel's request: its script and veil are not loaded. To bring
  it back, add the veil (<div class="footer-parallax__dark" data-footer-parallax-dark
  aria-hidden="true"></div>) after the footer and load the script after it.
{%- endcomment -%}
<div class="footer-parallax" data-footer-parallax>
  <footer
    class="footer color-{{ bs_page_scheme | default: section.settings.color_scheme }} gradient section-{{ section.id }}-padding"
    data-footer-parallax-inner
  >
    <div class="footer__inner page-width">
      <div class="footer__columns">
        {%- if section.settings.menu.links.size > 0 -%}
          <nav class="footer__nav" aria-label="{{ 'sections.footer.navigation' | t }}">
            <ul class="footer__list list-unstyled" role="list">
              {%- for link in section.settings.menu.links -%}
                <li>
                  <a
                    href="{{ link.url }}"
                    class="footer__link"
                    {% if link.current %}
                      aria-current="page"
                    {% endif %}
                  >
                    <span>{{ link.title | escape }}</span>
                    {%- render 'bs-menu-count', link: link -%}
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          </nav>
        {%- endif -%}

        <address class="footer__contact">
          <ul class="footer__list list-unstyled" role="list" aria-label="{{ 'sections.footer.contact' | t }}">
            {%- if section.settings.address != blank -%}
              <li>{{ section.settings.address | escape | newline_to_br }}</li>
            {%- endif -%}
            {%- if section.settings.email != blank -%}
              <li>
                <a href="mailto:{{ section.settings.email | strip | escape }}">{{ section.settings.email | escape }}</a>
              </li>
            {%- endif -%}
            {%- if section.settings.phone != blank -%}
              <li>
                <a href="tel:{{ section.settings.phone | remove: ' ' | escape }}">{{ section.settings.phone | escape }}</a>
              </li>
            {%- endif -%}
            {%- for network in bs_networks -%}
              {%- liquid
                if network == 'linkedin'
                  assign social_url = section.settings.linkedin_url
                else
                  assign social_setting = 'social_' | append: network | append: '_link'
                  assign social_url = settings[social_setting]
                endif
                assign social_label = 'general.social.links.' | append: network
              -%}
              {%- if social_url != blank -%}
                <li>
                  <a href="{{ social_url }}" target="_blank" rel="noopener">
                    {{- social_label | t -}}
                    <span class="visually-hidden">{{ 'accessibility.link_messages.new_window' | t }}</span>
                  </a>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </address>
      </div>

      {%- if settings.wholesale_portal_url != blank and section.settings.wholesale_label != blank -%}
        {%- comment -%}
          The pill with products fanned around it (Figma Footer V3). The products are decorative
          and sit behind the pill; assets/bs-footer-motion.js tucks them away and bursts them out
          on hover or focus (on scroll into view without hover). Per product: name, centre x and
          y and width as % of the cluster, rotation, file size in px, and the distance to the
          pill centre in cluster widths (for the tuck).
        {%- endcomment -%}
        {%- liquid
          assign bs_products = 'sprout|11.029|31.522|10.345|-30|168|425|0.3897|0.2072,sticky-chai|14.354|59.891|15.071|-52.07|245|348|0.3565|0.0819,smart-ass|27.447|27.145|18.22|-24.83|296|270|0.2255|0.2266,johnny-cashew|84.969|40.57|16.743|14.36|272|356|-0.3497|0.1672,tonys|73.813|46.166|21.761|-60|353|192|-0.2381|0.1425,matcha|84.969|71.502|13.964|39.57|227|343|-0.3497|0.0306,prana-chai|31.826|44.897|11.15|-8.93|181|345|0.1817|0.1481,ordinary|60.508|43.008|11.208|15|182|312|-0.1051|0.1565' | split: ','
        -%}
        <div class="footer__middle">
          <div class="footer__cluster" data-footer-cluster>
            {%- for bs_product in bs_products -%}
              {%- assign bs_p = bs_product | split: '|' -%}
              <img
                class="footer__product"
                src="{{ 'bs-footer-' | append: bs_p[0] | append: '.webp' | asset_url }}"
                alt=""
                width="{{ bs_p[5] }}"
                height="{{ bs_p[6] }}"
                loading="lazy"
                style="--x: {{ bs_p[1] }}%; --y: {{ bs_p[2] }}%; --w: {{ bs_p[3] }}%; --r: {{ bs_p[4] }}deg;"
                data-rotation="{{ bs_p[4] }}"
                data-tuck-x="{{ bs_p[7] }}"
                data-tuck-y="{{ bs_p[8] }}"
              >
            {%- endfor -%}
            <a
              href="{{ settings.wholesale_portal_url }}"
              class="footer__wholesale button bs-pill-xl"
              target="_blank"
              rel="noopener"
            >
              {{- section.settings.wholesale_label | escape -}}
              <span class="visually-hidden">{{ 'accessibility.link_messages.new_window' | t }}</span>
            </a>
          </div>
        </div>
      {%- endif -%}

      {%- comment -%}
        "BrewSociety. ©2026" loops sideways (assets/bs-footer-motion.js pauses it off screen).
        Two identical units, so moving the track by half its width is seamless. The second is
        hidden from screen readers; the year is also in the copyright line below.
      {%- endcomment -%}
      <div class="footer__strip" data-footer-marquee>
        <div class="footer__track">
          {%- for i in (1..2) -%}
            <div class="footer__unit"{% if forloop.first == false %} aria-hidden="true"{% endif %}>
              {%- render 'bs-wordmark', label: shop.name, class: 'footer__wordmark' -%}
              <span class="footer__marks">
                {%- render 'bs-display-figures', text: '©', class: 'footer__mark' -%}
                {%- render 'bs-display-figures', text: bs_year, class: 'footer__mark' -%}
              </span>
            </div>
          {%- endfor -%}
        </div>
      </div>

      <div class="footer__legal">
        <ul class="footer__policies list-unstyled" role="list">
          {%- if shop.privacy_policy != blank -%}
            <li>
              <a href="{{ shop.privacy_policy.url }}">{{ 'sections.footer.legal' | t }}</a>
            </li>
          {%- endif -%}
          {%- if shop.shipping_policy != blank -%}
            <li>
              <a href="{{ shop.shipping_policy.url }}">{{ 'sections.footer.shipping' | t }}</a>
            </li>
          {%- endif -%}
          {%- if shop.refund_policy != blank -%}
            <li>
              <a href="{{ shop.refund_policy.url }}">{{ 'sections.footer.returns' | t }}</a>
            </li>
          {%- endif -%}
          {%- if shop.terms_of_service != blank -%}
            <li>
              <a href="{{ shop.terms_of_service.url }}">{{ 'sections.footer.terms' | t }}</a>
            </li>
          {%- endif -%}
        </ul>
        <p class="visually-hidden">{{ 'sections.footer.copyright' | t: year: bs_year, name: shop.name }}</p>
        <a class="footer__credit" href="https://www.onetoo.com.au" target="_blank" rel="noopener">
          {{- 'sections.footer.site_by' | t -}}
          <span class="visually-hidden">{{ 'accessibility.link_messages.new_window' | t }}</span>
        </a>
      </div>
    </div>
  </footer>
</div>
<script src="{{ 'bs-footer-motion.js' | asset_url }}" defer="defer"></script>

{%- liquid
  comment
    Organization markup for search engines. Name, contact details and social links come from
    the store and this footer's settings, so they stay editable. The address (line breaks
    joined with spaces) is split into its parts when it reads "street, suburb STATE postcode";
    otherwise it is given as one line.
  endcomment
  assign bs_shop_name = shop.name | strip
  assign bs_shop_name_last = bs_shop_name | slice: -1
  if bs_shop_name_last == '.'
    assign bs_shop_name = bs_shop_name | remove_last: '.'
  endif

  assign bs_same_as = ''
  for bs_network in bs_networks
    if bs_network == 'linkedin'
      assign bs_url = section.settings.linkedin_url
    else
      assign bs_setting = 'social_' | append: bs_network | append: '_link'
      assign bs_url = settings[bs_setting]
    endif
    if bs_url != blank
      assign bs_same_as = bs_same_as | append: '|' | append: bs_url
    endif
  endfor
  assign bs_same_as = bs_same_as | remove_first: '|' | split: '|'

  assign bs_address = section.settings.address | newline_to_br | replace: '<br />', ' ' | strip_newlines | split: ' ' | join: ' '
  assign bs_street = blank
  assign bs_locality = blank
  assign bs_region = blank
  assign bs_postcode = blank
  if bs_address != blank
    assign bs_address_parts = bs_address | split: ','
    assign bs_street = bs_address
    if bs_address_parts.size == 2
      assign bs_place = bs_address_parts.last | strip | split: ' '
      assign bs_place_last = bs_place.last
      if bs_place.size >= 3 and bs_place_last.size == 4
        assign bs_street = bs_address_parts.first | strip
        assign bs_postcode = bs_place_last
        assign bs_region_index = bs_place.size | minus: 2
        assign bs_region = bs_place[bs_region_index]
        assign bs_locality = bs_place | slice: 0, bs_region_index | join: ' '
      endif
    endif
  endif
-%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": {{ bs_shop_name | json }},
    "url": {{ request.origin | append: routes.root_url | json }},
    "logo": {{ 'bs-logo-schema.png' | asset_url | prepend: 'https:' | json }},
    {%- if section.settings.email != blank %}
      "email": {{ section.settings.email | strip | json }},
    {%- endif -%}
    {%- if section.settings.phone != blank %}
      "telephone": {{ section.settings.phone | strip | json }},
    {%- endif -%}
    {%- if bs_street != blank %}
      "address": {
        "@type": "PostalAddress",
        "streetAddress": {{ bs_street | json }},
        {%- if bs_postcode != blank %}
          "addressLocality": {{ bs_locality | json }},
          "addressRegion": {{ bs_region | json }},
          "postalCode": {{ bs_postcode | json }},
        {%- endif %}
        "addressCountry": "AU"
      },
    {%- endif %}
    "sameAs": {{ bs_same_as | json }}
  }
</script>

{% schema %}
{
  "name": "t:sections.footer.name",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.footer.settings.color_scheme.label",
      "info": "t:sections.footer.settings.color_scheme.info",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.footer.settings.header_wholesale.content"
    },
    {
      "type": "paragraph",
      "content": "t:sections.footer.settings.wholesale_paragraph.content"
    },
    {
      "type": "text",
      "id": "wholesale_label",
      "default": "t:sections.footer.settings.wholesale_label.default",
      "label": "t:sections.footer.settings.wholesale_label.label"
    },
    {
      "type": "header",
      "content": "t:sections.footer.settings.header_navigation.content"
    },
    {
      "type": "link_list",
      "id": "menu",
      "default": "main-menu",
      "label": "t:sections.footer.settings.menu.label",
      "info": "t:sections.footer.settings.menu.info"
    },
    {
      "type": "header",
      "content": "t:sections.footer.settings.header_contact.content"
    },
    {
      "type": "textarea",
      "id": "address",
      "label": "t:sections.footer.settings.address.label",
      "info": "t:sections.footer.settings.address.info"
    },
    {
      "type": "text",
      "id": "email",
      "label": "t:sections.footer.settings.email.label"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "t:sections.footer.settings.phone.label"
    },
    {
      "type": "paragraph",
      "content": "t:sections.footer.settings.social_paragraph.content"
    },
    {
      "type": "url",
      "id": "linkedin_url",
      "label": "t:sections.footer.settings.linkedin_url.label"
    },
    {
      "type": "paragraph",
      "content": "t:sections.footer.settings.legal_paragraph.content"
    },
    {
      "type": "header",
      "content": "t:sections.all.spacing"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.footer.settings.margin_top.label",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 24
    }
  ]
}
{% endschema %}
