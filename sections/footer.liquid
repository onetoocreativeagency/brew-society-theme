          "id": "button_link_1",
          "label": "t:sections.footer.blocks.call_to_action.settings.button_link_1.label"
        },
        {
          "type": "text",
          "id": "button_label_2",
          "label": "t:sections.footer.blocks.call_to_action.settings.button_label_2.label",
          "info": "t:sections.footer.blocks.call_to_action.settings.button_label_2.info"
