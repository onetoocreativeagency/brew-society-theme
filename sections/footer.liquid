        },
        {
          "type": "text",
          "id": "button_label_1",
          "default": "t:sections.footer.blocks.call_to_action.settings.button_label_1.default",
          "label": "t:sections.footer.blocks.call_to_action.settings.button_label_1.label",
          "info": "t:sections.footer.blocks.call_to_action.settings.button_label_1.info"
        },
        {
