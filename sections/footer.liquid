{{ 'section-footer.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .footer {
    margin-top: {{ section.settings.margin_top | times: 0.75 | round: 0 }}px;
  }

  {%- comment -%} Figma: 192px top on desktop is 128px on mobile (two thirds); the bottom padding does not scale. {%- endcomment -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.667 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  @media screen and (min-width: 750px) {
    .footer {
      margin-top: {{ section.settings.margin_top }}px;
    }

    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
    }
  }
{%- endstyle -%}

<footer class="footer color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="footer__inner page-width">
    {%- if section.blocks.size > 0 -%}
      <div class="footer__main">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when '@app' -%}
              <div class="footer__block" {{ block.shopify_attributes }}>
                {% render block %}
              </div>
            {%- when 'menu' -%}
              {%- if block.settings.menu.links.size > 0 -%}
                <ul class="footer__block footer__menu list-unstyled" role="list" {{ block.shopify_attributes }}>
                  {%- for link in block.settings.menu.links -%}
                    <li>
                      <a
                        href="{{ link.url }}"
                        class="footer__menu-link"
                        {% if link.current %}
                          aria-current="page"
                        {% endif %}
                      >
                        <span>{{ link.title | escape }}</span>
                        {%- render 'bs-menu-count', link: link -%}
                      </a>
                    </li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            {%- when 'wholesale_button' -%}
              {%- if settings.wholesale_portal_url != blank and block.settings.label != blank -%}
                <a
                  href="{{ settings.wholesale_portal_url }}"
                  class="footer__block footer__wholesale button"
                  target="_blank"
                  rel="noopener"
                  {{ block.shopify_attributes }}
                >
                  {{ block.settings.label | escape }}
                  <span class="visually-hidden">{{ 'accessibility.link_messages.new_window' | t }}</span>
                </a>
              {%- endif -%}
            {%- when 'social_links' -%}
              {%- liquid
                assign social_networks = 'instagram,linkedin,facebook,youtube,tiktok,twitter,pinterest,snapchat,tumblr,vimeo' | split: ','
              -%}
              {%- capture social_items -%}
                {%- for network in social_networks -%}
                  {%- liquid
                    if network == 'linkedin'
                      assign social_url = block.settings.linkedin_url
                    else
                      assign social_setting = 'social_' | append: network | append: '_link'
                      assign social_url = settings[social_setting]
                    endif
                    assign social_label = 'general.social.links.' | append: network
                  -%}
                  {%- if social_url != blank -%}
                    <li>
                      <a href="{{ social_url }}" target="_blank" rel="noopener">
                        {{- social_label | t -}}
                        <span class="visually-hidden">{{ 'accessibility.link_messages.new_window' | t }}</span>
                      </a>
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              {%- endcapture -%}
              {%- if social_items != blank -%}
                <ul class="footer__details list-unstyled" role="list" {{ block.shopify_attributes }}>
                  {{ social_items }}
                </ul>
              {%- endif -%}
            {%- when 'contact' -%}
              {%- if block.settings.address != blank or block.settings.email != blank or block.settings.phone != blank -%}
                <ul class="footer__details list-unstyled" role="list" {{ block.shopify_attributes }}>
                  {%- if block.settings.address != blank -%}
                    <li>{{ block.settings.address | escape }}</li>
                  {%- endif -%}
                  {%- if block.settings.email != blank -%}
                    <li>
                      <a href="mailto:{{ block.settings.email | escape }}">{{ block.settings.email | escape }}</a>
                    </li>
                  {%- endif -%}
                  {%- if block.settings.phone != blank -%}
                    <li>
                      <a href="tel:{{ block.settings.phone | remove: ' ' | escape }}">
                        {{- block.settings.phone | escape -}}
                      </a>
                    </li>
                  {%- endif -%}
                </ul>
              {%- endif -%}
          {%- endcase -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="footer__bottom">
      {%- if section.settings.image != blank -%}
        <div class="footer__image">
          {{
            section.settings.image
            | image_url: width: 2008
            | image_tag:
              loading: 'lazy',
              widths: '375, 750, 1004, 1500, 2008',
              sizes: '(min-width: 750px) 1004px, 100vw'
          }}
        </div>
      {%- endif -%}
      <div class="footer__legal">
        {%- if section.settings.policy_menu.links.size > 0 -%}
          <ul class="footer__policies list-unstyled" role="list">
            {%- for link in section.settings.policy_menu.links -%}
              <li>
                <a href="{{ link.url }}">{{ link.title | escape }}</a>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
        <span class="footer__copyright">{{ shop.name | escape }} {{ 'now' | date: '%Y' }}</span>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "t:sections.footer.name",
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "menu",
      "name": "t:sections.footer.blocks.menu.name",
      "settings": [
        {
          "type": "link_list",
          "id": "menu",
          "default": "main-menu",
          "label": "t:sections.footer.blocks.menu.settings.menu.label",
          "info": "t:sections.footer.blocks.menu.settings.menu.info"
        }
      ]
    },
    {
      "type": "wholesale_button",
      "name": "t:sections.footer.blocks.wholesale_button.name",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "t:sections.footer.blocks.wholesale_button.settings.paragraph.content"
        },
        {
          "type": "text",
          "id": "label",
          "default": "t:sections.footer.blocks.wholesale_button.settings.label.default",
          "label": "t:sections.footer.blocks.wholesale_button.settings.label.label"
        }
      ]
    },
    {
      "type": "social_links",
      "name": "t:sections.footer.blocks.social_links.name",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "t:sections.footer.blocks.social_links.settings.paragraph.content"
        },
        {
          "type": "url",
          "id": "linkedin_url",
          "label": "t:sections.footer.blocks.social_links.settings.linkedin_url.label"
        }
      ]
    },
    {
      "type": "contact",
      "name": "t:sections.footer.blocks.contact.name",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "address",
          "label": "t:sections.footer.blocks.contact.settings.address.label"
        },
        {
          "type": "text",
          "id": "email",
          "label": "t:sections.footer.blocks.contact.settings.email.label"
        },
        {
          "type": "text",
          "id": "phone",
          "label": "t:sections.footer.blocks.contact.settings.phone.label"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-2"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.footer.settings.image.label",
      "info": "t:sections.footer.settings.image.info"
    },
    {
      "type": "link_list",
      "id": "policy_menu",
      "default": "footer",
      "label": "t:sections.footer.settings.policy_menu.label",
      "info": "t:sections.footer.settings.policy_menu.info"
    },
    {
      "type": "header",
      "content": "t:sections.all.spacing"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.footer.settings.margin_top.label",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 192
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 32
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "menu"
      },
      {
        "type": "wholesale_button"
      },
      {
        "type": "social_links"
      },
      {
        "type": "contact"
      }
    ]
  }
}
{% endschema %}
