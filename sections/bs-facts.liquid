{{ 'bs-facts.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  comment
    A fact without a value stays hidden: the numbers are the merchant's to type.
  endcomment
  assign fact_count = 0
  for block in section.blocks
    if block.settings.label != blank and block.settings.value != blank
      assign fact_count = fact_count | plus: 1
    endif
  endfor
-%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="bs-facts bs-facts--{{ section.settings.position }} page-width section-{{ section.id }}-padding">
    <div class="bs-facts__inner">
      {%- if section.settings.label != blank or section.settings.text != blank -%}
        <div class="bs-facts__copy">
          {%- if section.settings.label != blank -%}
            <h2 class="bs-facts__label">{{ section.settings.label | escape }}</h2>
          {%- endif -%}
          {%- if section.settings.text != blank -%}
            <div class="bs-facts__text rte">{{ section.settings.text }}</div>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if fact_count > 0 -%}
        <dl class="bs-facts__list">
          {%- for block in section.blocks -%}
            {%- if block.settings.label != blank and block.settings.value != blank -%}
              <div class="bs-facts__item" {{ block.shopify_attributes }}>
                <dt class="bs-facts__name">{{ block.settings.label | escape }}</dt>
                <dd class="bs-facts__value"><span>{{ block.settings.value | escape }}</span></dd>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </dl>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Text with facts",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "About"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "select",
      "id": "position",
      "label": "Position on desktop",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Centre" },
        { "value": "right", "label": "Right" }
      ],
      "default": "right"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-2"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 256,
      "step": 8,
      "unit": "px",
      "label": "Top padding",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 256,
      "step": 8,
      "unit": "px",
      "label": "Bottom padding",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "fact",
      "name": "Fact",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Brands"
        },
        {
          "type": "text",
          "id": "value",
          "label": "Number or value",
          "info": "The fact stays hidden until this is filled in."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Text with facts",
      "blocks": [
        {
          "type": "fact"
        }
      ]
    }
  ]
}
{% endschema %}
