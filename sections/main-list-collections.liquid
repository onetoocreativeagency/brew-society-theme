{{ 'component-collection-hero.css' | asset_url | stylesheet_tag }}
{{ 'template-collection.css' | asset_url | stylesheet_tag }}
{{ 'bs-brands.css' | asset_url | stylesheet_tag }}
{%- comment -%}
  Flip animates the grid/list switch. GSAP itself is loaded by layout/theme.liquid (a second copy
  would replace window.gsap and its registered plugins). bs-brands.js snaps between views without them.
{%- endcomment -%}
<script src="{{ 'Flip.min.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'bs-brands.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  {%- comment -%} Phones: at most 64px from the header to the title, as on every page. {%- endcomment -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.5 | round: 0 | at_most: 64 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.5 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- comment -%}
  Brands catalogue (Figma Brands - All 4166:4283, List View 4166:4532).
  Lists every collection that uses the "brand" template. The category links are
  built from the brands' own category values, so nothing is named here.
{%- endcomment -%}
{%- liquid
  capture bs_tally
    render 'bs-brand-each', item: 'tally', config: section.settings
  endcapture
  # Shopify leaves a line break after each rendered collection, so line breaks are removed before counting.
  assign bs_total = bs_tally | strip_newlines | strip | size
  capture bs_category_values
    render 'bs-brand-each', item: 'category', config: section.settings
  endcapture
  assign bs_category_values = bs_category_values | strip_newlines | strip | split: '|||'
  assign bs_categories = bs_category_values | uniq | sort_natural
  assign bs_title = section.settings.title | default: collections.title
-%}

<bs-brand-catalogue
  data-list-grid-init
  class="bs-brands color-{{ section.settings.color_scheme }} gradient"
  data-default-view="{{ section.settings.default_view }}"
  data-count-one="{{ 'sections.brands.count.one' | t: count: '[count]' | escape }}"
  data-count-other="{{ 'sections.brands.count.other' | t: count: '[count]' | escape }}"
>
  {%- comment -%} Sets the view before the first paint, so a linked list view never flashes the grid. {%- endcomment -%}
  <script>
    (function () {
      var el = document.currentScript.parentElement;
      var view = new URLSearchParams(window.location.search).get('view');
      el.dataset.view = view === 'list' || view === 'grid' ? view : el.dataset.defaultView;
    })();
  </script>
  <div class="page-width section-{{ section.id }}-padding">
    {%- comment -%}
      The heading reads "Brands" to search engines and screen readers. The visible title and
      count (which change with the category tabs) sit in a paragraph styled as the title, hidden
      from assistive tech; the count is announced from the line after it.
    {%- endcomment -%}
    <h1 class="visually-hidden">{{ 'general.seo.brands_title' | t }}</h1>
    {%- comment -%} No whitespace before the number: the count sits tight against the title. {%- endcomment -%}
    <p class="collection-hero__title hxxl" aria-hidden="true"><span data-brands-title>{{ bs_title | escape }}</span><span class="collection-hero__count"><span data-brands-count>{{ bs_total }}</span></span></p>
    <p class="visually-hidden" data-brands-count-text>{{ 'sections.brands.count' | t: count: bs_total }}</p>

    <div class="bs-collection-bar bs-brands__bar">
      {%- if bs_categories.size > 0 -%}
        <nav class="bs-category-nav" aria-label="{{ 'sections.collection_template.categories' | t }}">
          <ul class="bs-category-nav__list list-unstyled" role="list">
            <li>
              <a
                href="{{ routes.collections_url }}"
                class="bs-category-nav__link bs-category-nav__link--current"
                aria-current="true"
                data-brands-filter=""
                data-brands-label="{{ bs_title | escape }}"
                data-brands-total="{{ bs_total }}"
              >
                {{- bs_title | escape -}}
              </a>
            </li>
            {%- for bs_category in bs_categories -%}
              {%- liquid
                assign bs_category_count = 0
                for bs_value in bs_category_values
                  if bs_value == bs_category
                    assign bs_category_count = bs_category_count | plus: 1
                  endif
                endfor
              -%}
              <li>
                <a
                  href="{{ routes.collections_url }}?category={{ bs_category | handleize }}"
                  class="bs-category-nav__link"
                  data-brands-filter="{{ bs_category | handleize }}"
                  data-brands-label="{{ bs_category | escape }}"
                  data-brands-total="{{ bs_category_count }}"
                >
                  {{- bs_category | escape -}}
                  <span class="bs-menu-count" aria-hidden="true">{{ bs_category_count }}</span>
                  <span class="visually-hidden">, {{ 'sections.brands.count' | t: count: bs_category_count }}</span>
                </a>
              </li>
            {%- endfor -%}
          </ul>
        </nav>
      {%- endif -%}
      {%- comment -%}
        Pill toggle with a sliding indicator (Osmo Supply "List/Grid Toggle (Flip)"). Shown once the
        script has set the view; without it the grid is shown.
      {%- endcomment -%}
      <div class="bs-brands__views" role="group" aria-label="{{ 'sections.brands.view' | t }}">
        <span class="bs-brands__indicator" data-list-grid-flip></span>
        <button
          type="button"
          class="bs-brands__view bs-brands__view--grid"
          data-list-grid-toggle="grid"
          aria-pressed="false"
        >
          {{- 'sections.brands.grid_view' | t -}}
        </button>
        <button
          type="button"
          class="bs-brands__view bs-brands__view--list"
          data-list-grid-toggle="list"
          aria-pressed="false"
        >
          {{- 'sections.brands.list_view' | t -}}
        </button>
      </div>
    </div>

    <p class="visually-hidden" role="status" data-brands-status></p>

    {%- render 'bs-brand-finder' -%}

    {%- comment -%}
      One set of brands for both views (snippets/bs-brand-card.liquid). The column heads show in
      the list view only. bs-brand-list moves the list view's logo square after the cursor.
    {%- endcomment -%}
    <script src="{{ 'bs-brand-list.js' | asset_url }}" defer="defer"></script>
    <bs-brand-list class="bs-brands__items">
      <div class="bs-brands__head" aria-hidden="true" data-list-grid-fade="list">
        <span class="bs-brands__head-name">{{ 'sections.brands.name' | t }}</span>
        <span class="bs-brand-card__cell--category">{{ 'sections.brands.category' | t }}</span>
        <span class="bs-brand-card__cell--products">{{ 'sections.brands.products' | t }}</span>
        <span class="bs-brand-card__cell--origin">{{ 'sections.brands.origin' | t }}</span>
        <span class="bs-brand-card__cell--type">{{ 'sections.brands.type' | t }}</span>
      </div>
      <ul class="bs-brand-grid list-unstyled" role="list">
        {%- render 'bs-brand-each', item: 'card', config: section.settings -%}
      </ul>
    </bs-brand-list>
  </div>
</bs-brand-catalogue>

{% schema %}
{
  "name": "Brands catalogue",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Lists every collection that uses the brand template. Category links come from the brands' category values."
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "info": "Shown before the number of brands, and as the link that clears the category filter.",
      "default": "All"
    },
    {
      "type": "select",
      "id": "default_view",
      "label": "Opens in",
      "options": [
        {
          "value": "grid",
          "label": "Grid view"
        },
        {
          "value": "list",
          "label": "List view"
        }
      ],
      "default": "grid"
    },
    {
      "type": "select",
      "id": "card_image",
      "label": "Card image",
      "info": "Product shot is the collection image. Either one falls back to the other when it is missing.",
      "options": [
        {
          "value": "product",
          "label": "Product shot"
        },
        {
          "value": "logo",
          "label": "Brand logo"
        }
      ],
      "default": "logo"
    },
    {
      "type": "color_scheme",
      "id": "card_color_scheme",
      "label": "Card panel colours",
      "default": "scheme-2"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Brand data"
    },
    {
      "type": "paragraph",
      "content": "Brand details are collection metafields. Change these only if the metafield definitions are renamed."
    },
    {
      "type": "text",
      "id": "namespace",
      "label": "Metafield namespace",
      "default": "brand"
    },
    {
      "type": "text",
      "id": "category_key",
      "label": "Category metafield key",
      "default": "category"
    },
    {
      "type": "text",
      "id": "origin_key",
      "label": "Origin metafield key",
      "default": "origin"
    },
    {
      "type": "text",
      "id": "relationship_key",
      "label": "Relationship metafield key",
      "default": "relationship"
    },
    {
      "type": "text",
      "id": "exclusive_key",
      "label": "Exclusive metafield key",
      "default": "exclusive"
    },
    {
      "type": "text",
      "id": "new_key",
      "label": "New metafield key",
      "default": "new"
    },
    {
      "type": "text",
      "id": "logo_key",
      "label": "Logo metafield key",
      "default": "logo"
    },
    {
      "type": "text",
      "id": "range_size_key",
      "label": "Range size metafield key",
      "default": "range_size"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 256,
      "step": 8,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 256
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 256,
      "step": 8,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 96
    }
  ]
}
{% endschema %}
